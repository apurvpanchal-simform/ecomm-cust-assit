GOOGLE_API_KEY=<your-key>
EMBEDDING_MODEL=models/gemini-embedding-2
PRIMARY_MODEL=llama-3.3-70b-versatile

QDRANT_URL=http://localhost:6333

LANGSMITH_TRACING=true
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-key>
LANGSMITH_PROJECT="ecomm-cust-assist"

MAX_ITERATIONS=3

JWT_SECRET_KEY=<your-secret>
JWT_EXPIRATION_HOURS=1

SUPABASE_URL=<your-url>
SUPABASE_KEY=<your-key>
SUPABASE_DB_URL=postgresql://postgres.[project-id]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

GROQ_API_KEY=<your-key>

REDIS_URL=redis://localhost:6379

API_BASE_URL=http://localhost:8000

# ── Azure ─────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=product-images

AZURE_VISION_ENDPOINT=https://<region>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your_key>

AZURE_CONTENT_MODERATOR_ENDPOINT=https://<region>.cognitiveservices.azure.com/
AZURE_CONTENT_MODERATOR_KEY=<your_key>