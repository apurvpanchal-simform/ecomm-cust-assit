GOOGLE_API_KEY=<your-key>
GROQ_API_KEY=<your-key>

OPENAI_API_KEY=<your-key>
OPENAI_BASE_URL=https://api.chatanywhere.org/v1

OPENROUTER_API_KEY=<your-key>
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=models/gemini-embedding-2
CLIP_MODEL=google/siglip-base-patch16-224

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:8000

LANGFUSE_SECRET_KEY=<your-secret-key>
LANGFUSE_PUBLIC_KEY=<your-public-key>
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

JWT_SECRET_KEY=<your-secret>
JWT_EXPIRATION_HOURS=1

SUPABASE_URL=<your-url>
SUPABASE_KEY=<your-key>
SUPABASE_DB_URL=postgresql://postgres.[project-id]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=product-images

AZURE_VISION_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_VISION_KEY=copy_your_key_1_here

HF_TOKEN=<your-huggingface-token>

CHAINLIT_AUTH_SECRET=<your-chainlit-auth-secret>

# ── SEARCH THRESHOLDS & SETTINGS ──────────────────────────────────────────────
SEARCH_PREFETCH_LIMIT=20
SEARCH_IMAGE_SCORE_THRESHOLD=0.02
SEARCH_TEXT_SCORE_THRESHOLD=0.02
SEARCH_RRF_SCORE_THRESHOLD=0.15
SEARCH_LOG_LIMIT=5
SEARCH_FUSION_LIMIT=3
FAQ_SEARCH_THRESHOLD=0.50
FAQ_SEMANTIC_CACHE_THRESHOLD=0.75
FAQ_TOP_K=5

# ── LLM FACTORY & AGENT SETTINGS ──────────────────────────────────────────────
PRIMARY_LLM_MODEL=openai/gpt-oss-20b
FALLBACK_1_LLM_MODEL=openai/gpt-oss-120b
FALLBACK_2_LLM_MODEL=gemini-3.1-flash-lite
LLM_MAX_RETRIES=3
LLM_TIMEOUT=15.0

SUPERVISOR_LLM_TEMPERATURE=0.0
SUPERVISOR_LLM_CACHE=none
FAQ_LLM_TEMPERATURE=0.4
FAQ_LLM_CACHE=none
ORDER_LLM_TEMPERATURE=0.1
ORDER_LLM_CACHE=false
SUMMARIZER_LLM_TEMPERATURE=0.0
SUMMARIZER_LLM_CACHE=none
SYNTHESIZER_LLM_TEMPERATURE=0.3
SYNTHESIZER_LLM_CACHE=none

MAX_ITERATIONS=6

# ── AUTH & RATE LIMIT SETTINGS ──────────────────────────────────────────────
JWT_ALGORITHM=HS256
RATE_LIMIT_NORMAL_LIMIT=10
RATE_LIMIT_SPAM_THRESHOLD=20
RATE_LIMIT_BAN_DURATION_SECONDS=86400